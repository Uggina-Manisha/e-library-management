{% extends "library/base.html" %}
{% block content %}

<style>
    body {
        background: linear-gradient(135deg, #6a11cb, #2575fc);
        background-attachment: fixed;
    }
    .login-card {
        max-width: 420px;
        margin: 70px auto;
        padding: 30px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        animation: fadeIn 0.6s ease-in-out;
    }
    @keyframes fadeIn {
        from {opacity: 0; transform: translateY(20px);}
        to {opacity: 1; transform: translateY(0);}
    }
    .login-title {
        font-weight: 700;
        color: #2575fc;
    }
    .btn-login {
        background: #2575fc;
        border: none;
    }
    .btn-login:hover {
        background: #1b5ed0;
    }
</style>

<div class="login-card">
    <h3 class="text-center login-title">Welcome Back!</h3>
    <p class="text-center mb-4">Login to continue</p>

    {% if error %}
    <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    <form method="post">
        {% csrf_token %}
        <div class="mb-3">
            <label class="form-label"><strong>Username</strong></label>
            <input type="text" name="username" class="form-control" placeholder="Enter your username" required>
        </div>

        <div class="mb-3">
            <label class="form-label"><strong>Password</strong></label>
            <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
        </div>

        <button class="btn btn-login text-white w-100 py-2">Login</button>
    </form>

    <p class="text-center mt-3">
        Don’t have an account? <a href="/signup/" class="text-primary">Sign up</a>
    </p>
</div>

{% endblock %}r Account Creation and Login
